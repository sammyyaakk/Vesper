# Run environment: development | production
NODE_ENV=development

# Optional: trace | debug | info | warn | error (default: info)
LOG_LEVEL=

# Public URL of the client, used for links in emails (required in production)
APP_URL=http://localhost:5173

# Clerk (dashboard.clerk.com → API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres (console.neon.tech → Connection string)
# DATABASE_URL: pooled connection, used by the app at runtime
# DIRECT_URL: direct (non-pooled) connection, used by Prisma migrations
DATABASE_URL=
DIRECT_URL=

# Inngest (app.inngest.com → Manage → Keys); not needed with the local dev server
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# SMTP credentials for outgoing email
SENDER_EMAIL=
SMTP_USER=
SMTP_PASS=
