{
  "name": "vesper-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "sync:clerk": "tsx scripts/sync-clerk.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "docker compose -f ../compose.test.yaml up -d --wait",
    "bench:db": "docker compose -f ../compose.bench.yaml up -d --wait",
    "bench:seed": "tsx scripts/bench/seed.ts",
    "bench": "tsx scripts/bench/run.ts",
    "bench:explain": "tsx scripts/bench/explain.ts",
    "redis:dev": "docker compose -f ../compose.dev.yaml up -d --wait"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/autocannon": "7.12.7",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "autocannon": "8.0.0",
    "pino-pretty": "13.1.3",
    "prisma": "6.18.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@clerk/express": "^1.7.26",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/adapter-neon": "^6.15.0",
    "@prisma/client": "^6.15.0",
    "@socket.io/redis-adapter": "8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "inngest": "^3.54.2",
    "ioredis": "6.0.0",
    "nodemailer": "^7.0.9",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "ws": "^8.18.3",
    "zod": "4.6.5"
  }
}
